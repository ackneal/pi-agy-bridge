{
  "name": "pi-agy-bridge",
  "version": "0.1.3",
  "description": "Standalone AGY provider and Pi capability bridge plugin for Pi",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "agy",
    "mcp"
  ],
  "license": "MIT",
  "packageManager": "bun@1.3.13",
  "type": "module",
  "exports": "./src/extension/index.ts",
  "bin": {
    "pi-agy-bridge-mcp": "./src/mcp/index.js"
  },
  "files": [
    "src/extension",
    "src/mcp",
    "plugin",
    "README.md",
    "LICENSE",
    "!**/*.test.ts"
  ],
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-timeout=15000 \"**/*.test.ts\""
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.0 <2.0.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0 <2.0.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@types/node": "26.6.3",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  }
}
