{
  "name": "@ackneal/pi-agy-bridge",
  "version": "0.5.1",
  "description": "Use Antigravity models in Pi via Google's official ACP server, with native Pi tool and extension support.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "agy",
    "mcp",
    "antigravity",
    "acp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ackneal/pi-agy-bridge.git"
  },
  "homepage": "https://github.com/ackneal/pi-agy-bridge#readme",
  "bugs": {
    "url": "https://github.com/ackneal/pi-agy-bridge/issues"
  },
  "packageManager": "bun@1.3.13",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": "./src/extension/index.ts",
  "bin": {
    "pi-agy-bridge-mcp": "./src/mcp/index.js"
  },
  "files": [
    "src/extension",
    "src/mcp",
    "plugin",
    "README.md",
    "LICENSE",
    "!**/*.test.ts",
    "!**/*-fixture.ts"
  ],
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "scripts": {
    "check:version": "node scripts/check-version.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-transform-types --test --test-timeout=30000 \"**/*.test.ts\""
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.6.3",
    "@types/yauzl": "3.4.0",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  }
}
